# =============================================================================
# ELMKUSOMA Backend Configuration
# =============================================================================
# Copy this file to .env and fill in your local values.
# The .env file is git-ignored and will NOT be committed.
#
#   1. Copy:  cp .env.example .env
#   2. Edit:  Set DB_PASSWORD to your local PostgreSQL password
#   3. Start: .\start-backend.ps1   (or cd backend/elmkusoma-core && mvnw spring-boot:run)
#
# HOW THIS FILE REACHES THE RUNNING SERVICES
# ------------------------------------------
# Precedence, highest first:
#     1. a real environment variable
#     2. an already-set system property
#     3. a value from this file
#     4. the default in application.yml
# This file only ever fills gaps; it never overwrites what you set yourself.
#
#   elmkusoma-core     reads backend/.env ITSELF at startup (./.env, then ../.env
#                      accepted only from a directory that ships an .env.example,
#                      so a stray .env higher up the tree is never picked up).
#                      It prints the file path and the KEY NAMES it applied -
#                      never values.
#   elmkusoma-media    does NOT read this file. It reads ambient environment
#   elmkusoma-workers  variables. start-backend.ps1 and start-dev.ps1 parse this
#   elmkusoma-realtime file into the process environment before launching them,
#                      and docker-compose.yml supplies `environment:` blocks.
#                      Launching one of those jars from a bare shell will NOT
#                      pick up values written only in this file.
#
# This file is a LOCAL DEVELOPMENT convenience. It is not a production secret
# management solution: in production set real environment variables / secrets in
# your orchestrator, never bake this file into an image.
#
# RESTART: every setting below is read once at startup. Restart the consuming
# service after changing it.
#
# VERIFY WITHOUT DISPLAYING VALUES:  grep -o '^[A-Za-z_][A-Za-z0-9_]*' .env
# (names only). See docs/audits/ELMKUSOMA_CREDENTIAL_SETUP_AND_FINAL_VERIFICATION.md
# for per-variable presence checks that never print a value.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED IN EVERY DEPLOYMENT
# ---------------------------------------------------------------------------

# Database - All developers MUST use the same database name: elmkusoma
# Consumed by: elmkusoma-core, elmkusoma-media, elmkusoma-workers
# Format: host/port/name/user. SECRET: DB_PASSWORD.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elmkusoma
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# JWT signing key - Consumed by: elmkusoma-core, elmkusoma-media, elmkusoma-realtime
# (elmkusoma-workers does not use it). SECRET. No default: startup fails loudly
# without it, which is intentional.
# Format: Base64, at least 32 random bytes - elmkusoma-realtime decodes it and
# requires a >=256-bit HMAC key, so a short value aborts that service at boot.
# Generate:  openssl rand -base64 32
# Changing it invalidates every issued token (all users are logged out).
JWT_SECRET=generate-a-secure-base64-encoded-key-here

# ---------------------------------------------------------------------------
# A. PLATFORM ADMIN FIRST-BOOT PROVISIONING  (opt-in, one-time)
# Consumed by: elmkusoma-core (AdminUserInitializer)
# ---------------------------------------------------------------------------
# Safe behaviour already in the code, verified by AdminUserInitializerTest:
#   * disabled by default;
#   * if the admin account already exists it is NEVER modified - password, role
#     and status are left untouched, so a restart cannot restore a backdoor;
#   * if enabled with no password it refuses to start rather than defaulting.
# Use: set both on a FRESH database only, boot once, confirm the account exists,
# then remove ADMIN_BOOTSTRAP_PASSWORD and set ELM_BOOTSTRAP_ADMIN=false again.
# Leaving ELM_BOOTSTRAP_ADMIN=true afterwards is unnecessary but harmless.
# SECRET: ADMIN_BOOTSTRAP_PASSWORD. Restart: yes.
# ELM_BOOTSTRAP_ADMIN=false
# ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ---------------------------------------------------------------------------
# B. MFA AUTHENTICATOR SECRET ENCRYPTION
# Consumed by: elmkusoma-core (MfaEncryptionService)
# ---------------------------------------------------------------------------
# Algorithm as implemented: AES/GCM/NoPadding, 12-byte random IV per encryption,
# envelope "base64(iv).base64(ciphertext)". The value must be Base64 that decodes
# to EXACTLY 32 bytes (AES-256); non-Base64 or the wrong length is rejected with
# an explicit error. There is no fallback key - without it, MFA enrollment and
# every MFA login fail loudly at runtime (the service still boots).
# Generate locally (never paste the result into chat, a commit or a report):
#     openssl rand -base64 32
# SECRET: yes. Restart: yes.
# ROTATION WARNING: do not rotate an existing key casually. Changing it makes
# every already-enrolled authenticator secret undecryptable, so all users would
# have to re-enroll (or be recovered manually). Rotate only with a plan for that.
# MFA_ENCRYPTION_KEY=generate-a-base64-32-byte-key-here

# ---------------------------------------------------------------------------
# C. PUBLIC FRONTEND URL (account-recovery links)
# Consumed by: elmkusoma-core (AuthServiceImpl, PlatformAdminService)
# ---------------------------------------------------------------------------
# Binds to app.frontend-url. Both names work; FRONTEND_URL is what this file
# documents and is the one the core .env loader supplies.
# Used to build:  <base>/reset-password?token=…
#                 <base>/verify-email?token=…
#                 <base>/login
# Format: absolute http(s) origin, NO trailing slash, no query/fragment.
# Validated at startup by FrontendUrlValidator. Under the `prod` profile a
# loopback host (localhost / 127.0.0.1 / ::1 / *.localhost) is REJECTED so that
# production can never silently email localhost links.
# Required in production; defaults to http://localhost:3000 for local dev.
# Restart: yes.
# FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# D. GENERAL MEDIA STORAGE (elmkusoma-media ONLY)
# ---------------------------------------------------------------------------
# THIS IS NOT THE RECORDING STORE. See "LiveKit Egress" below for recordings.
#   media/storage  = uploaded course media, thumbnails, the Media Library
#   livekit.egress = the byte stream of a live class, written by LiveKit itself
# Setting MEDIA_STORAGE or MINIO_* changes only the first.
#
# Consumed ONLY by elmkusoma-media, which does not read this file itself -
# the values arrive as ambient environment variables (see header). Values here
# take effect when started through start-backend.ps1 / start-dev.ps1 / compose.
#
# MEDIA_STORAGE   "minio" (default) or "local" (filesystem; used where MinIO is
#                 unavailable). start-backend.ps1 defaults it to "local".
# MEDIA_LOCAL_DIR used only when MEDIA_STORAGE=local. Optional: defaults to
#                 ${java.io.tmpdir}/elmkusoma-media
# MINIO_*         used only when MEDIA_STORAGE=minio.
#                 NOTE: the media application.yml ships well-known development
#                 credentials as defaults. They are fine locally; never expose
#                 the media service with them in a non-local environment.
# Restart: yes.
# MEDIA_STORAGE=minio
# MEDIA_LOCAL_DIR=
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=CHANGE_ME
# MINIO_SECRET_KEY=CHANGE_ME
# MINIO_BUCKET=elmkusoma-media

# ---------------------------------------------------------------------------
# E. SMTP / TRANSACTIONAL EMAIL
# Consumed by: elmkusoma-core (OtpMailService - OTP codes, direct SMTP)
#              elmkusoma-workers (EmailServiceImpl - queue-driven mail via
#                                 elmkusoma.email.queue)
# ---------------------------------------------------------------------------
# BOTH services need these; setting them for one does not configure the other.
# Missing credentials never fail a request - delivery is best-effort, so OTP and
# recovery mail is silently undeliverable until this is real. Failures surface
# as send-time errors and queue retries, not as startup failures.
# Provider note: Gmail/Google require an APP PASSWORD (not the account password)
# and SMTP submission on 587 with STARTTLS.
# Restart: both services. SECRET: SPRING_MAIL_PASSWORD.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-account@example.com
# SPRING_MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD

# Optional SMTP tuning (core only): defaults shown.
# SPRING_MAIL_CONN_TIMEOUT=3000
# SPRING_MAIL_TIMEOUT=3000
# SPRING_MAIL_WRITE_TIMEOUT=3000
# SPRING_MAIL_STARTTLS=false

# ---------------------------------------------------------------------------
# F. OTHER SERVICES
# ---------------------------------------------------------------------------

# Redis / RabbitMQ. The default (dev) profile hardcodes localhost:6379 and
# localhost:5672 inside application.yml. The `prod` profile externalises them:
# Redis/RabbitMQ are read from REDIS_*/RABBITMQ_* only under that profile.
# Defaults there are the docker-compose service names.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest

# Service discovery URLs - Consumed by: elmkusoma-core. Defaults shown.
# MEDIA_SERVICE_URL=http://localhost:8083
# REALTIME_SERVICE_URL=http://localhost:8081
# WORKERS_SERVICE_URL=http://localhost:8082

# Optional AI provider - Consumed by: elmkusoma-core (AiController). Both default
# to empty; the feature is inert until set.
# AI_PROVIDER=
# AI_API_KEY=

# Payment provider webhook signature - Consumed by: elmkusoma-core
# (PaymentWebhookController). SECRET. Optional: empty is a deliberate fail-closed
# state - every webhook is rejected and logged until this is set, so nothing can
# be forged, but no payment confirmation can be applied either. Configure it only
# when payments are actually used. Restart: yes.
# PAYMENT_WEBHOOK_SECRET=CHANGE_ME_PROVIDER_WEBHOOK_SECRET

# ---------------------------------------------------------------------------
# STAKABA mobile-money gateway (https://docs.stakaba.com/) - Consumed by:
# elmkusoma-core only. The frontend NEVER holds these values.
#
# SANDBOX ONLY. Get your sandbox key (sk_test_...) from app.stakaba.com ->
# Settings -> API Keys. Never paste a real key into this file, a commit, a
# screenshot or chat - put it in backend/.env (git-ignored). A key starting
# with sk_live_ is refused at startup unless STAKABA_ALLOW_LIVE=true is also
# set, which must not be done without an approved go-live. Restart: yes.
#
# To confirm this file is correct WITHOUT printing the key:
#     .\start-backend.ps1 -VerifyConfig
# It reports whether each variable is set and classifies the key as sandbox or
# live from its prefix. It never prints a value.
#
# Quotes are optional: STAKABA_API_KEY="sk_test_..." and STAKABA_API_KEY=sk_test_...
# behave identically. One layer of matching surrounding quotes is stripped on
# load. A key with quotes left in would stop matching the sk_test_ prefix and be
# rejected as "not a Stakaba key".
# ---------------------------------------------------------------------------
# Selects the outbound provider adapter. Leave as "none" (or unset) to keep
# the legacy manual-verification flow. Set to stakaba only together with
# STAKABA_ENABLED=true below.
# ELMKUSOMA_PAYMENT_PROVIDER=none
# STAKABA_ENABLED=false
# Verified sandbox base URL (same URL serves live; the key selects the mode).
# STAKABA_BASE_URL=https://api.stakaba.com
# Sandbox API key, e.g. sk_test_xxxxxxxxxxxxxxxx. Required when enabled.
# STAKABA_API_KEY=
# Optional timeouts (milliseconds) for gateway HTTP calls.
# STAKABA_CONNECT_TIMEOUT_MS=5000
# STAKABA_READ_TIMEOUT_MS=15000
# Live-key interlock. Leave false/unset. Never enable for sandbox testing.
# STAKABA_ALLOW_LIVE=false
# The transaction-status lookup sends both x-api-key and Authorization: Bearer,
# because Stakaba's OpenAPI spec declares HTTPBearer for that endpoint while its
# prose guides use x-api-key. Set false to send only x-api-key.
# STAKABA_SEND_BEARER_FALLBACK=true

# ---------------------------------------------------------------------------
# LIVEKIT (real-time video/audio - app runs without it, just chat-only)
# Get these from your LiveKit Cloud project or self-hosted server.
# NEVER commit real credentials - keep them in backend/.env (git-ignored).
# Consumed by: elmkusoma-core only. The frontend NEVER holds these: it receives a
# short-lived participant token minted by the backend.
# Restart: yes.
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Ingress (optional, pulls an external stream in). All default to empty/off.
# LIVEKIT_INGRESS_ENABLED=false
# LIVEKIT_WHIP_ENDPOINT=
# LIVEKIT_RTMP_ENDPOINT=
# LIVEKIT_SRT_ENDPOINT=

# ---------------------------------------------------------------------------
# RECORDING (LiveKit Egress -> Backblaze B2)
# ---------------------------------------------------------------------------
# LiveKit records the session and uploads the file to storage YOU own, so a bucket
# plus S3-compatible credentials are required before recording can start. With these
# unset, starting a recording is refused with a clear "storage is not configured"
# response rather than a half-started capture.
# These names match `livekit.egress.*` in application.yml.
# Consumed by: elmkusoma-core. SECRET: LIVEKIT_EGRESS_S3_ACCESS_KEY,
# LIVEKIT_EGRESS_S3_SECRET. Restart: yes. Status: code path verified by unit and
# integration tests; the B2 upload itself is UNVERIFIED until real credentials are
# used for one real recording.
#
#   LIVEKIT_EGRESS_ENABLED         master switch for recording (false = off)
#   LIVEKIT_EGRESS_BUCKET          bucket that receives the recording files
#   LIVEKIT_EGRESS_PATH            key prefix inside that bucket
#   LIVEKIT_EGRESS_S3_ACCESS_KEY   S3-compatible Access Key ID
#   LIVEKIT_EGRESS_S3_SECRET       S3-compatible Secret Access Key
#   LIVEKIT_EGRESS_S3_REGION       storage region; must match the bucket's region
#   LIVEKIT_EGRESS_S3_ENDPOINT     S3 endpoint; required for Backblaze B2 / MinIO / R2,
#                                  omit only for AWS S3 which needs no custom endpoint
#
# Backblaze B2: the endpoint is https://s3.<region>.backblazeb2.com and MUST use the
# same region as the bucket. Prefer a bucket-scoped Application Key over the master key.
# LIVEKIT_EGRESS_ENABLED=false
# LIVEKIT_EGRESS_BUCKET=your-recording-bucket
# LIVEKIT_EGRESS_PATH=recordings/
# LIVEKIT_EGRESS_S3_ACCESS_KEY=your-access-key-id
# LIVEKIT_EGRESS_S3_SECRET=your-secret-access-key
# LIVEKIT_EGRESS_S3_REGION=your-bucket-region
# LIVEKIT_EGRESS_S3_ENDPOINT=https://s3.your-bucket-region.backblazeb2.com
#
# ---- SETUP ----------------------------------------------------------------------
#  1. Create the bucket in Backblaze B2 and leave it PRIVATE. Never make it public:
#     playback must go through the app's entitlement-checked endpoints, not the bucket.
#  2. Create a bucket-scoped Application Key (listFiles/writeFiles/readFiles on that
#     bucket only) rather than the master application key.
#  3. Copy this block into backend/.env and fill ONLY the two credential lines. Never
#     put credentials in this tracked file, in a commit, in a log or in a report.
#  4. Leave LIVEKIT_EGRESS_ENABLED=false, restart, verify, then set it to true and
#     restart again. Two steps on purpose: the switch is only turned on once storage
#     has been proven reachable.
#
# ---- CONFIGURATION VALIDATION ----------------------------------------------------
#  * Startup logs a redacted ERROR naming exactly which of the settings above are
#    missing when LIVEKIT_EGRESS_ENABLED=true - it names variables, never values.
#    Recording being half-configured does NOT stop the rest of the platform booting.
#  * The start request itself is refused (503) while storage is unusable, so no
#    doomed egress job is ever created.
#  * LIVEKIT_EGRESS_S3_ENDPOINT must be an absolute http(s) URL or it is reported.
#
# ---- VERIFICATION (after enabling) ------------------------------------------------
#  * POST /v1/live-session/classes/{classId}/recording/start no longer answers
#    "Recording storage is not configured on the server."
#  * The response carries an egress id, and live_classes.recording_url becomes
#    "egress:<id>".
#  * After the session ends, a file exists under the recordings/ prefix in the bucket.
#  * Exactly one row exists in replays for that session and exactly one in media_assets
#    with source_type=LIVE_CLASS and source_id=<class id> - check this after ending the
#    class twice or re-delivering a webhook, which is the case the unique indexes guard.
#  * LiveKit's Egress dashboard shows the job ended EGRESS_COMPLETE.
#
# ---- PLAYBACK (authorization) -----------------------------------------------------
#  The bucket stays PRIVATE and clients are never given its URL. API responses expose an
#  application-owned, entitlement-checked playback URL instead:
#      /v1/replays/{replayId}/playback
#      /v1/live-session/classes/{classId}/recording/playback
#  Role, institution, class ownership and session participation are re-checked on EVERY
#  request - including every Range request a player makes while seeking - so a copied,
#  shared or screenshotted URL grants nothing on its own.
#  Because <video src> cannot carry an Authorization header, the browser sends the
#  application's own elmkusoma_access_token cookie on these two paths only. Same token,
#  same JWT validation, same expiry; no other endpoint accepts it.
#  Optional (defaults shown):
# RECORDING_PLAYBACK_CONNECT_TIMEOUT_MS=5000
# RECORDING_PLAYBACK_READ_TIMEOUT_MS=60000
#
# ---- OPERATIONAL FAILURES ---------------------------------------------------------
#  * 503 "Recording storage is not configured on the server."
#      hasStorage() is false: bucket, access key, secret, or region+endpoint is empty.
#      Nothing is captured. Fix the credentials, not the code.
#  * Recording ran, but no Replay and no Media Asset afterwards
#      Look for "Recording URL unresolved" (the in-request poll timed out - the
#      egress_ended webhook is now expected to finish publication) or "Recording
#      publication failed". A missing location is never invented, so the recording is
#      left pending rather than published as a broken link.
#  * LiveKit returns AccessDenied / 403 when starting
#      The application key cannot write that prefix, or bucket and key belong to
#      different accounts.
#  * Object is in the bucket but the browser cannot play it
#      For live-class recordings the frontend uses the stored recordingUrl DIRECTLY
#      (<a href>, <video src>, window.open) - there is no byte-level proxy for them
#      (MediaProxyService only serves media-library resources). So what happens
#      depends on what LiveKit put in file_results[].location, which has never been
#      observed here:
#        - a plain https://<endpoint>/<bucket>/recordings/... URL against a PRIVATE
#          bucket returns 403 to the browser: playback fails, nothing leaks;
#        - a signed URL plays until it expires, then needs regenerating.
#      Either way the LISTING endpoints stay entitlement-checked (@PreAuthorize), so a
#      user who is not allowed to see the class never learns the URL. What is NOT yet
#      demonstrated is per-request entitlement on the byte fetch. Record the actual
#      location value from the first real recording before drawing conclusions.
#      Do NOT "fix" a 403 by making the bucket public.
#
# ---- ROLLBACK --------------------------------------------------------------------
#  * Set LIVEKIT_EGRESS_ENABLED=false and restart. Recording stops being startable.
#    Nothing recorded is deleted, and no schema change is reversed.
#  * Remove the four non-secret values if the bucket should be forgotten entirely.
#  * Migration V159 (unique index on replays) is additive, protects data rather than
#    depending on this configuration, and stays in place on rollback.

# ---------------------------------------------------------------------------
# LOCAL OVERRIDES
# ---------------------------------------------------------------------------
# Anything above can be overridden for one run by exporting a real environment
# variable of the same name - the file never wins over it.
