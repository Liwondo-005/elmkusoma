# =============================================================================
# ELMKUSOMA Backend Configuration
# =============================================================================
# Copy this file to .env and fill in your local values.
# The .env file is git-ignored and will NOT be committed.
#
# Usage:
#   1. Copy:  cp .env.example .env
#   2. Edit:  Set DB_PASSWORD to your local PostgreSQL password
#   3. Start: cd backend/elmkusoma-core && mvnw spring-boot:run
# =============================================================================

# Database - All developers MUST use the same database name: elmkusoma
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elmkusoma
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# JWT - Generate a secure random key for production
JWT_SECRET=generate-a-secure-base64-encoded-key-here

# Optional: Redis & RabbitMQ (app runs without them, just warns)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest

# LiveKit (real-time video/audio - app runs without it, just chat-only)
# Get these from your LiveKit Cloud project or self-hosted server.
# NEVER commit real credentials - keep them in backend/.env (git-ignored).
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Platform Admin first-boot provisioning (opt-in).
# The initializer NEVER resets an existing account; it only creates a missing
# admin. Leave disabled unless you are bootstrapping a fresh database.
# ELM_BOOTSTRAP_ADMIN=false
# ADMIN_BOOTSTRAP_PASSWORD=generate-a-strong-password-here

# MFA authenticator secret encryption (AES-256-GCM, Base64, 32 bytes).
# REQUIRED for authenticator enrollment; enrollment fails fast without it.
# Generate: openssl rand -base64 32
# MFA_ENCRYPTION_KEY=generate-a-base64-32-byte-key-here

# Public frontend base URL used to build emailed recovery links.
# FRONTEND_URL=http://localhost:3000

# Media object storage selection: "minio" (default, production) or "local"
# (filesystem; used where MinIO is unavailable).
# MEDIA_STORAGE=minio
# MEDIA_LOCAL_DIR=
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=elmkusoma-media

# SMTP for transactional mail (workers service). Without real credentials the
# workers mail sender fails at send time; recovery emails queue in RabbitMQ.
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password
