# =============================================================================
# ELMKUSOMA .gitignore
# =============================================================================

# Environment files (keep .env.example, ignore actual .env)
.env
.env.local
.env.*.local
backend/.env

# Build artifacts
backend/*/target/
backend/*.log
frontend/.next/
frontend/node_modules/

# IDE
.idea/
.vscode/
*.iml
*.class

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Backup files
*.backup
*.bak

# Temp build/run scripts
backend/*.bat
backend/*.cmd
*.bat
*.cmd

# Empty junk files
CD
type
git

# Generated frontend types
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# Redis dump
dump.rdb
*.rdb

# Database dumps (contain sensitive data)
database_full.sql
database_schema.sql
elmkusoma_dump.sql
frontend/e2e/test-results/
frontend/e2e/playwright-report/
